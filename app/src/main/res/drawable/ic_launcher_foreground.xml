        <!-- Sun -->
        <path
            android:fillColor="#E3B04B"
            android:pathData="M62,40a8,8 0,1 0,16 0a8,8 0,1 0,-16 0z" />
        <!-- Far ridge -->
        <path
            android:fillColor="#9DBF9E"
            android:pathData="M0,58 C12,52 22,45 32,46 C42,47 46,54 56,53 C66,52 70,42 80,42 C90,42 98,49 108,52 V120 H0 Z" />
