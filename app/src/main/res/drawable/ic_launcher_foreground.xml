            android:fillColor="#4E7D5B"
            android:pathData="M0,70 C14,62 30,60 44,64 C54,67 60,69 68,66 C80,61 94,59 108,64 V120 H0 Z" />
        <!-- Near hill -->
        <path
            android:fillColor="#1B3A2A"
            android:pathData="M0,84 C20,76 44,78 64,84 C82,89 96,84 108,80 V120 H0 Z" />
        <!-- The path -->
        <path
            android:fillColor="#F4F0E8"
            android:pathData="M26,120 C29,114 31,111 33,108 C40,100 62,98 60,91 C58,85 44,84 46,78 C47,73 54,71 57.2,67.2 L58.8,67.2 C57,71 52,74 52.5,78 C53,82 70,85 71,92 C72,99 62,103 56,108 C55,112 54,116 54,120 Z" />
